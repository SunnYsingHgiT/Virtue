@model Virtue.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div style="margin-left:33%;margin-top: 8%;">
    <h2>Login</h2>
    <div class="card w-50 shadow-sm">
        <div class="card-body">
            <form method="post" asp-action="Login" asp-controller="Auth">
                <div class="form-group my-2">
                    <label for="email">Email:</label>
                    <input type="email" class="form-control" id="email" name="email" asp-for="Email" placeholder="Enter email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <label for="password">Password:</label>
                    <input type="password" class="form-control" id="password" name="password" asp-for="Password" placeholder="Enter password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="my-2">
                    <button type="submit" class="btn btn-primary">Login</button>
                    <a href="/Auth/Register">Register</a>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
